 "opening": true,
 "unit": 35,
 "unit_title": "My day",
 "situation": "Home and daily routine",
 "can_do": "describe what you do every day",
 "dialogue": [
  {
   "sq": "Në çfarë ore zgjohesh?",
   "en": "What time do you wake up?"
  },
  {
   "sq": "Në orën gjashtë. Çoj fëmijët në shkollë, pastaj shkoj në punë.",
   "en": "At six. I take the children to school, then I go to work."
  },
  {
   "sq": "Dhe pas punës?",
   "en": "And after work?"
  },
  {
   "sq": "Gatuaj darkën dhe laj pjatat.",
   "en": "I cook dinner and wash the dishes."
  },
  {
   "sq": "Duhet të jesh shumë e lodhur!",
   "en": "You must be very tired!"
  },
  {
   "sq": "Po, por të dielën pushoj.",
   "en": "Yes, but on Sunday I rest."
  }
 ]
}