 "opening": true,
 "unit": 36,
 "unit_title": "Free time",
 "situation": "Home and daily routine",
 "can_do": "say what you like doing in your free time",
 "dialogue": [
  {
   "sq": "Çfarë bën në kohën e lirë?",
   "en": "What do you do in your free time?"
  },
  {
   "sq": "Lexoj shumë dhe dëgjoj muzikë. Dhe ti?",
   "en": "I read a lot and listen to music. And you?"
  },
  {
   "sq": "Unë luaj futboll dhe notoj.",
   "en": "I play football and swim."
  },
  {
   "sq": "Të pëlqen kinemaja?",
   "en": "Do you like the cinema?"
  },
  {
   "sq": "Shumë! Shkojmë sonte? Ka një film të ri.",
   "en": "A lot! Shall we go tonight? There is a new film."
  },
  {
   "sq": "Me kënaqësi!",
   "en": "With pleasure!"
  }
 ]
