 "dialogue": [
  {
   "sq": "Ke ndonjë problem?",
   "en": "Do you have a problem?"
  },
  {
   "sq": "Jo, gjithçka është në rregull.",
   "en": "No, everything is all right."
  },
  {
   "sq": "Do diçka tjetër?",
   "en": "Do you want something else?"
  },
  {
   "sq": "Po, një kafe tjetër, të lutem.",
   "en": "Yes, another coffee, please."
  },
  {
   "sq": "Ja kafja. Diçka tjetër?",
   "en": "Here is the coffee. Anything else?"
  },
  {
   "sq": "Jo, mjaft. Faleminderit!",
   "en": "No, that's enough. Thank you!"
  }
