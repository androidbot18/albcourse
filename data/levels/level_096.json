   "sq": "Ke vëllezër apo motra?",
   "en": "Do you have brothers or sisters?"
  },
  {
   "sq": "Po, kam një vëlla dhe dy motra. Dhe ti?",
   "en": "Yes, I have a brother and two sisters. And you?"
  },
  {
   "sq": "Unë kam vetëm një motër. Quhet Arta.",
   "en": "I have only one sister. She is called Arta."
  },
  {
   "sq": "Ku jetojnë prindërit e tu?",
   "en": "Where do your parents live?"
  },
  {
