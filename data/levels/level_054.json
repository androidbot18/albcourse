 "dialogue": [
  {
   "sq": "Mirëmbrëma! Keni një tavolinë për dy?",
   "en": "Good evening! Do you have a table for two?"
  },
  {
   "sq": "Po, ja ku është. Ja menuja.",
   "en": "Yes, here it is. Here is the menu."
  },
  {
   "sq": "Çfarë rekomandoni?",
   "en": "What do you recommend?"
  },
  {
   "sq": "Peshku është shumë i freskët sot.",
   "en": "The fish is very fresh today."
  },
  {
   "sq": "Mirë, dy peshq dhe një sallatë, ju lutem.",
   "en": "Good, two fish and a salad, please."
  },
  {
   "sq": "Ju bëftë mirë!",
   "en": "Enjoy your meal!"
