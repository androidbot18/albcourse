 "unit": 14,
 "unit_title": "Money",
 "situation": "Numbers and money",
 "can_do": "ask what something costs and pay for it",
 "dialogue": [
  {
   "sq": "Sa kushton kafja?",
   "en": "How much is the coffee?"
  },
  {
   "sq": "Njëqind e pesëdhjetë lekë.",
   "en": "A hundred and fifty lek."
  },
  {
   "sq": "Mund të paguaj me kartë?",
   "en": "Can I pay by card?"
  },
  {
   "sq": "Më vjen keq, vetëm me para.",
   "en": "I am sorry, only with cash."
  },
  {
   "sq": "Në rregull. Ja një mijë lekë.",
   "en": "All right. Here is a thousand lek."
  },
  {
   "sq": "Ja kusuri juaj. Faleminderit!",
   "en": "Here is your change. Thank you!"
  }
 ]
