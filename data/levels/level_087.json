 "dialogue": [
  {
   "sq": "Çfarë dite është sot?",
   "en": "What day is it today?"
  },
  {
   "sq": "Sot është e enjte.",
   "en": "Today is Thursday."
  },
  {
   "sq": "Je i lirë të shtunën? Kam ditëlindjen.",
   "en": "Are you free on Saturday? It is my birthday."
  },
  {
   "sq": "Gëzuar ditëlindjen! Po, jam i lirë.",
   "en": "Happy birthday! Yes, I am free."
  },
  {
   "sq": "Mirë. Festa është në orën tetë, te shtëpia ime.",
   "en": "Good. The party is at eight o'clock, at my house."
  },
  {
   "sq": "Vij patjetër!",
   "en": "I will definitely come!"
