 "opening": true,
 "unit": 25,
 "unit_title": "Places to see",
 "situation": "Directions and transport",
 "can_do": "talk about where you have been and want to go",
 "dialogue": [
  {
   "sq": "Keni qenë në Sarandë?",
   "en": "Have you been to Sarandë?"
  },
  {
   "sq": "Jo, akoma jo. Si është?",
   "en": "No, not yet. What is it like?"
  },
  {
   "sq": "Shumë e bukur. Ka plazhe dhe një kështjellë.",
   "en": "Very beautiful. It has beaches and a castle."
  },
  {
   "sq": "Sa larg është nga Tirana?",
   "en": "How far is it from Tirana?"
  },
  {
   "sq": "Rreth katër orë me autobus. Ia vlen!",
   "en": "About four hours by bus. It is worth it!"
  },
  {
   "sq": "Atëherë shkoj nesër.",
   "en": "Then I am going tomorrow."
  }
 ]
}