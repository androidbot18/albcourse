 "situation": "Everyday talk",
 "can_do": "talk about facts, wishes and what matters",
 "dialogue": [
  {
   "sq": "Kam ndryshuar mendje. Nuk e blej makinën.",
   "en": "I have changed my mind. I am not buying the car."
  },
  {
   "sq": "Pse? Ishte në gjendje të mirë.",
   "en": "Why? It was in good condition."
  },
  {
   "sq": "Në fakt, është shumë e shtrenjtë për mua.",
   "en": "In fact, it is too expensive for me."
  },
  {
   "sq": "Nuk ka rëndësi. Gjejmë një tjetër.",
   "en": "It doesn't matter. We will find another one."
  },
  {
   "sq": "Ke të drejtë. Faleminderit për ndihmën!",
   "en": "You are right. Thank you for the help!"
  }
 ]
