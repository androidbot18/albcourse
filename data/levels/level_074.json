 "unit": 23,
 "unit_title": "Getting around",
 "situation": "Directions and transport",
 "can_do": "buy a ticket and use buses, trains and taxis",
 "dialogue": [
  {
   "sq": "Një biletë për Durrës, ju lutem.",
   "en": "A ticket to Durrës, please."
  },
  {
   "sq": "Pesëqind lekë.",
   "en": "Five hundred lek."
  },
  {
   "sq": "Kur niset autobusi?",
   "en": "When does the bus leave?"
  },
  {
   "sq": "Në orën dhjetë. Arrin në Durrës në njëmbëdhjetë.",
   "en": "At ten o'clock. It arrives in Durrës at eleven."
  },
  {
   "sq": "Ku ndalon?",
   "en": "Where does it stop?"
  },
  {
   "sq": "Te stacioni, përballë bankës.",
   "en": "At the station, opposite the bank."
  }
 ]
