   "sq": "Përshëndetje! Çfarë ka të re?",
   "en": "Hello! What's new?"
  },
  {
   "sq": "Asgjë e re. Punoj pothuajse çdo ditë. Dhe ti?",
   "en": "Nothing new. I work almost every day. And you?"
  },
  {
   "sq": "Javën e ardhshme shkoj në Itali!",
   "en": "Next week I am going to Italy!"
  },
  {
   "sq": "Vërtet? Unë nuk kam qenë asnjëherë atje.",
   "en": "Really? I have never been there."
  },
  {
   "sq": "As unë. Mezi pres!",
   "en": "Me neither. I can't wait!"
  }
