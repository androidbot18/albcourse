 "opening": true,
 "unit": 41,
 "unit_title": "Nature and animals",
 "situation": "Weather and nature",
 "can_do": "name animals and things you see outdoors",
 "dialogue": [
  {
   "sq": "Ke kafshë në shtëpi?",
   "en": "Do you have animals at home?"
  },
  {
   "sq": "Po, kemi një qen dhe dy mace. Dhe ti?",
   "en": "Yes, we have a dog and two cats. And you?"
  },
  {
   "sq": "Jo, por gjyshi im ka shumë kafshë në fshat.",
   "en": "No, but my grandfather has many animals in the village."
  },
  {
   "sq": "Çfarë kafshësh?",
   "en": "What animals?"
  },
  {
   "sq": "Lopë, dele dhe një kalë.",
   "en": "Cows, sheep and a horse."
  },
  {
   "sq": "Sa bukur! Më pëlqen shumë natyra.",
   "en": "How nice! I like nature very much."
  }
 ]
}