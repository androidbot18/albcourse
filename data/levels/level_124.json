 "opening": true,
 "unit": 39,
 "unit_title": "At the doctor's",
 "situation": "Feelings and health",
 "can_do": "say what hurts and ask for help",
 "dialogue": [
  {
   "sq": "Mirëdita. Çfarë problemi keni?",
   "en": "Good day. What is the problem?"
  },
  {
   "sq": "Më dhemb koka dhe kam temperaturë.",
   "en": "I have a headache and a temperature."
  },
  {
   "sq": "Prej sa kohësh?",
   "en": "For how long?"
  },
  {
   "sq": "Prej dy ditësh. Kam edhe kollë.",
   "en": "For two days. I also have a cough."
  },
  {
   "sq": "Është grip. Merrni këtë ilaç dhe pushoni.",
   "en": "It is the flu. Take this medicine and rest."
  },
  {
   "sq": "Faleminderit, doktor.",
   "en": "Thank you, doctor."
  }
 ]
