 "opening": true,
 "unit": 40,
 "unit_title": "The weather",
 "situation": "Weather and nature",
 "can_do": "talk about the weather",
 "dialogue": [
  {
   "sq": "Si është moti sot?",
   "en": "What is the weather like today?"
  },
  {
   "sq": "Bie shi dhe bën ftohtë.",
   "en": "It is raining and it is cold."
  },
  {
   "sq": "Dhe nesër?",
   "en": "And tomorrow?"
  },
  {
   "sq": "Parashikimi është i mirë. Do të ketë diell.",
   "en": "The forecast is good. It will be sunny."
  },
  {
   "sq": "Atëherë nesër shkojmë në plazh!",
   "en": "Then tomorrow we go to the beach!"
  },
  {
   "sq": "Po, por merr edhe një xhaketë. Moti ndryshon shpejt.",
   "en": "Yes, but take a jacket too. The weather changes quickly."
  }
 ]
