 "situation": "Home and daily routine",
 "can_do": "name furniture and everyday objects",
 "dialogue": [
  {
   "sq": "Ku i vendos këto libra?",
   "en": "Where shall I put these books?"
  },
  {
   "sq": "Në raft, pranë televizorit.",
   "en": "On the shelf, next to the television."
  },
  {
   "sq": "Dhe kutinë?",
   "en": "And the box?"
  },
  {
   "sq": "Në dollap. Është e rëndë!",
   "en": "In the cupboard. It is heavy!"
  },
  {
   "sq": "Në rregull. Ndez dritën, të lutem.",
   "en": "All right. Turn on the light, please."
  }
 ]
