 "can_do": "name the months and say which season you like",
 "dialogue": [
  {
   "sq": "Cila stinë të pëlqen më shumë?",
   "en": "Which season do you like most?"
  },
  {
   "sq": "Vera, sepse më pëlqen deti. Dhe ty?",
   "en": "Summer, because I like the sea. And you?"
  },
  {
   "sq": "Mua më pëlqen pranvera. Nuk është shumë nxehtë.",
   "en": "I like spring. It is not too hot."
  },
  {
   "sq": "Kur e ke ditëlindjen?",
   "en": "When is your birthday?"
  },
  {
   "sq": "Në maj.",
   "en": "In May."
  },
  {
   "sq": "Edhe unë!",
   "en": "Me too!"
  }
