 "unit_title": "Messages and the internet",
 "situation": "Phone and messages",
 "can_do": "talk about email, apps and the news",
 "dialogue": [
  {
   "sq": "Ke internet në telefon?",
   "en": "Do you have internet on your phone?"
  },
  {
   "sq": "Jo, nuk ka rrjet këtu. Dhe bateria është gati bosh.",
   "en": "No, there is no signal here. And the battery is almost empty."
  },
  {
   "sq": "Ja karikuesi im.",
   "en": "Here is my charger."
  },
  {
   "sq": "Faleminderit! Duhet të dërgoj një email.",
   "en": "Thank you! I have to send an email."
  },
  {
   "sq": "Hoteli ka internet. Fjalëkalimi është te dhoma.",
   "en": "The hotel has internet. The password is in the room."
  }
 ]
