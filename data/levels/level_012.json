 "dialogue": [
  {
   "sq": "Më falni, zotëri!",
   "en": "Excuse me, sir!"
  },
  {
   "sq": "Po? Keni një problem?",
   "en": "Yes? Do you have a problem?"
  },
  {
   "sq": "Më vjen keq, kjo është kafja ime.",
   "en": "I am sorry, this is my coffee."
  },
  {
   "sq": "Më falni! Gabimi im.",
   "en": "Sorry! My mistake."
  },
  {
   "sq": "S'ka gjë. Në rregull.",
   "en": "It's nothing. All right."
  }
