 "dialogue": [
  {
   "sq": "Mirëdita! Çfarë dëshironi?",
   "en": "Good day! What would you like?"
  },
  {
   "sq": "Do të doja një kafe me qumësht, ju lutem.",
   "en": "I would like a coffee with milk, please."
  },
  {
   "sq": "Me sheqer?",
   "en": "With sugar?"
  },
  {
   "sq": "Jo, pa sheqer. Dhe një gotë ujë.",
   "en": "No, without sugar. And a glass of water."
  },
  {
   "sq": "Sigurisht. Diçka tjetër?",
   "en": "Of course. Anything else?"
  },
  {
   "sq": "Jo, faleminderit.",
   "en": "No, thank you."
  }
