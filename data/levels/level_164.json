 "unit": 51,
 "unit_title": "Life in Albania",
 "situation": "Everyday talk",
 "can_do": "talk about the country, its people and work",
 "dialogue": [
  {
   "sq": "Mirë se erdhe në Shqipëri! Të pëlqen këtu?",
   "en": "Welcome to Albania! Do you like it here?"
  },
  {
   "sq": "Shumë! Më pëlqen kultura dhe historia.",
   "en": "A lot! I like the culture and the history."
  },
  {
   "sq": "Dhe njerëzit?",
   "en": "And the people?"
  },
  {
   "sq": "Janë shumë të mirë. Mikpritja shqiptare është e famshme.",
   "en": "They are very good. Albanian hospitality is famous."
  },
  {
   "sq": "Është një traditë e vjetër. Kalofsh mirë!",
   "en": "It is an old tradition. Have a good time!"
  }
 ]
