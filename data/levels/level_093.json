 "dialogue": [
  {
   "sq": "Më falni, sa është ora?",
   "en": "Excuse me, what time is it?"
  },
  {
   "sq": "Është nëntë pa një çerek.",
   "en": "It is a quarter to nine."
  },
  {
   "sq": "Kur fillon takimi?",
   "en": "When does the meeting start?"
  },
  {
   "sq": "Në orën nëntë. Zgjat një orë.",
   "en": "At nine o'clock. It lasts an hour."
  },
  {
   "sq": "Atëherë duhet të nxitoj!",
   "en": "Then I have to hurry!"
  },
  {
   "sq": "Shko, shko! Je në kohë.",
   "en": "Go, go! You are on time."
  }
