 "opening": true,
 "unit": 44,
 "unit_title": "Changing plans",
 "situation": "Phone and messages",
 "can_do": "cancel, postpone and confirm plans",
 "dialogue": [
  {
   "sq": "Ana, më fal, duhet të anuloj darkën sonte.",
   "en": "Ana, sorry, I have to cancel dinner tonight."
  },
  {
   "sq": "Çfarë ndodhi?",
   "en": "What happened?"
  },
  {
   "sq": "Kam një takim në punë. Fatkeqësisht, nuk mund ta refuzoj.",
   "en": "I have a meeting at work. Unfortunately, I can't refuse it."
  },
  {
   "sq": "S'ka problem. E shtyjmë për nesër?",
   "en": "No problem. Shall we postpone it until tomorrow?"
  },
  {
   "sq": "Po, nesër është e mundur. Të premtoj!",
   "en": "Yes, tomorrow is possible. I promise!"
  },
  {
   "sq": "Mirë, më njofto.",
   "en": "Good, let me know."
  }
 ]
}