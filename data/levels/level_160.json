 "can_do": "talk about moving, putting and changing things",
 "dialogue": [
  {
   "sq": "Ku e vë këtë kuti?",
   "en": "Where shall I put this box?"
  },
  {
   "sq": "Më lër të mendoj... Sipër, mbi dollap.",
   "en": "Let me think... On top, on the cupboard."
  },
  {
   "sq": "Është shumë e rëndë. Nuk mund ta ngre vetëm.",
   "en": "It is very heavy. I can't lift it alone."
  },
  {
   "sq": "Prit pak! Të ndihmoj unë.",
   "en": "Wait a bit! I will help you."
  },
  {
   "sq": "Faleminderit. Kujdes, mos e prek llambën!",
   "en": "Thank you. Careful, don't touch the lamp!"
  }
 ]
