 "opening": true,
 "unit": 16,
 "unit_title": "Food",
 "situation": "Café and restaurant",
 "can_do": "name what you eat and say what you like",
 "dialogue": [
  {
   "sq": "Çfarë të pëlqen të hash?",
   "en": "What do you like to eat?"
  },
  {
   "sq": "Më pëlqen peshku me perime. Dhe ti?",
   "en": "I like fish with vegetables. And you?"
  },
  {
   "sq": "Unë nuk ha peshk. Më pëlqen mishi me patate.",
   "en": "I don't eat fish. I like meat with potatoes."
  },
  {
   "sq": "Dhe ëmbëlsira?",
   "en": "And desserts?"
  },
  {
   "sq": "Akullore, gjithmonë!",
   "en": "Ice cream, always!"
  }
 ]
