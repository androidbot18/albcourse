 "dialogue": [
  {
   "sq": "Kush është ai në foto?",
   "en": "Who is that in the photo?"
  },
  {
   "sq": "Është kushëriri im. Jeton në Kosovë.",
   "en": "He is my cousin. He lives in Kosovo."
  },
  {
   "sq": "Dhe kjo grua?",
   "en": "And this woman?"
  },
  {
   "sq": "Tezja ime, motra e nënës.",
   "en": "My aunt, my mother's sister."
  },
  {
   "sq": "Ke një familje të madhe!",
   "en": "You have a big family!"
  },
  {
   "sq": "Po, kemi shumë të afërm.",
   "en": "Yes, we have many relatives."
  }
