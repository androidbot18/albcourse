 "opening": true,
 "unit": 37,
 "unit_title": "How do you feel?",
 "situation": "Feelings and health",
 "can_do": "say how you feel and ask others",
 "dialogue": [
  {
   "sq": "Si ndihesh sot?",
   "en": "How do you feel today?"
  },
  {
   "sq": "Jo shumë mirë. Jam pak e shqetësuar.",
   "en": "Not very well. I am a little worried."
  },
  {
   "sq": "Çfarë ke?",
   "en": "What is wrong?"
  },
  {
   "sq": "Nesër kam një takim në punë dhe kam frikë.",
   "en": "Tomorrow I have a meeting at work and I am afraid."
  },
  {
   "sq": "Mos u shqetëso! Ti punon shumë mirë.",
   "en": "Don't worry! You work very well."
  },
  {
   "sq": "Faleminderit. Tani ndihem më mirë.",
   "en": "Thank you. Now I feel better."
  }
 ]
