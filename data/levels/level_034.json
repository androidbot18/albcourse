 "opening": true,
 "unit": 11,
 "unit_title": "Here and there",
 "situation": "Yes, no and the small words",
 "can_do": "say where things are",
 "dialogue": [
  {
   "sq": "Ku është çelësi im?",
   "en": "Where is my key?"
  },
  {
   "sq": "Nuk është mbi tavolinë?",
   "en": "Is it not on the table?"
  },
  {
   "sq": "Jo, atje është vetëm telefoni.",
   "en": "No, only the phone is there."
  },
  {
   "sq": "Ndoshta është në çantë.",
   "en": "Maybe it is in the bag."
  },
  {
   "sq": "Po, ja ku është! Faleminderit.",
   "en": "Yes, here it is! Thank you."
  }
 ]
}