 "situation": "Opinions and connecting words",
 "can_do": "give your opinion and agree or disagree",
 "dialogue": [
  {
   "sq": "Çfarë mendon për këtë restorant?",
   "en": "What do you think of this restaurant?"
  },
  {
   "sq": "Mendoj se është pak i shtrenjtë.",
   "en": "I think it is a little expensive."
  },
  {
   "sq": "Ke të drejtë, por ushqimi është shumë i mirë.",
   "en": "You are right, but the food is very good."
  },
  {
   "sq": "Është e vërtetë. Sipas meje, peshku këtu është më i miri në qytet.",
   "en": "That is true. In my opinion, the fish here is the best in town."
  },
  {
   "sq": "Jam dakord.",
   "en": "I agree."
  }
 ]
