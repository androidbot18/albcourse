 "unit": 33,
 "unit_title": "The house",
 "situation": "Home and daily routine",
 "can_do": "describe where you live",
 "dialogue": [
  {
   "sq": "Ku banon tani?",
   "en": "Where do you live now?"
  },
  {
   "sq": "Kam një apartament në qendër.",
   "en": "I have a flat in the centre."
  },
  {
   "sq": "Është i madh?",
   "en": "Is it big?"
  },
  {
   "sq": "Jo, ka vetëm një dhomë gjumi dhe një kuzhinë të vogël.",
   "en": "No, it has only one bedroom and a small kitchen."
  },
  {
   "sq": "Dhe qiraja?",
   "en": "And the rent?"
  },
  {
   "sq": "Nuk është e shtrenjtë. Dhe lagjja është e qetë.",
   "en": "It is not expensive. And the neighbourhood is quiet."
  }
 ]
