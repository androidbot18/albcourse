 "opening": true,
 "unit": 42,
 "unit_title": "On the phone",
 "situation": "Phone and messages",
 "can_do": "make and answer a phone call",
 "dialogue": [
  {
   "sq": "Alo?",
   "en": "Hello?"
  },
  {
   "sq": "Mirëdita! Mund të flas me Benin, ju lutem?",
   "en": "Good day! Can I speak to Beni, please?"
  },
  {
   "sq": "Më vjen keq, nuk është këtu. Kush flet?",
   "en": "I am sorry, he is not here. Who is speaking?"
  },
  {
   "sq": "Jam Ana, një kolege. Mund të lë një mesazh?",
   "en": "I am Ana, a colleague. Can I leave a message?"
  },
  {
   "sq": "Sigurisht.",
   "en": "Of course."
  },
  {
   "sq": "I thoni të më telefonojë, ju lutem.",
   "en": "Tell him to phone me, please."
  }
 ]
}