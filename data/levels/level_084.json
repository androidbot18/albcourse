 "opening": true,
 "unit": 26,
 "unit_title": "Yesterday, today, tomorrow",
 "situation": "Time, days and plans",
 "can_do": "say when something happens",
 "dialogue": [
  {
   "sq": "Çfarë bën këtë fundjavë?",
   "en": "What are you doing this weekend?"
  },
  {
   "sq": "Zakonisht jam në shtëpi, por këtë herë shkoj në plazh.",
   "en": "I am usually at home, but this time I am going to the beach."
  },
  {
   "sq": "Shkon shpesh atje?",
   "en": "Do you go there often?"
  },
  {
   "sq": "Jo, rrallë. Herën e fundit isha vitin e kaluar.",
   "en": "No, rarely. The last time I was there was last year."
  },
  {
   "sq": "Atëherë udhëtim të mbarë!",
   "en": "Then have a good trip!"
  },
  {
   "sq": "Faleminderit! Shihemi javën e ardhshme.",
   "en": "Thank you! See you next week."
  }
 ]
