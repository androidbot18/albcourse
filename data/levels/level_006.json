 "dialogue": [
  {
   "sq": "Kush është ky?",
   "en": "Who is this?"
  },
  {
   "sq": "Ky është Beni, miku im.",
   "en": "This is Beni, my friend."
  },
  {
   "sq": "Mirëdita, Beni! Gëzohem që u njohëm.",
   "en": "Good day, Beni! Nice to meet you."
  },
  {
   "sq": "Edhe unë. Si jeni?",
   "en": "Me too. How are you?"
  },
  {
   "sq": "Shumë mirë, faleminderit.",
   "en": "Very well, thank you."
  }
