 "opening": true,
 "unit": 24,
 "unit_title": "At the hotel",
 "situation": "Directions and transport",
 "can_do": "check in and ask about your room",
 "dialogue": [
  {
   "sq": "Mirëmbrëma! Kam një rezervim për dy net.",
   "en": "Good evening! I have a booking for two nights."
  },
  {
   "sq": "Emri juaj, ju lutem?",
   "en": "Your name, please?"
  },
  {
   "sq": "Quhem Ana. Ja pasaporta ime.",
   "en": "My name is Ana. Here is my passport."
  },
  {
   "sq": "Faleminderit. Dhoma juaj është në katin e tretë.",
   "en": "Thank you. Your room is on the third floor."
  },
  {
   "sq": "Ka pamje nga deti?",
   "en": "Does it have a sea view?"
  },
  {
   "sq": "Po. Ja çelësi. Mëngjesi është në orën tetë.",
   "en": "Yes. Here is the key. Breakfast is at eight o'clock."
  }
 ]
