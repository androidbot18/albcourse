 "situation": "Opinions and connecting words",
 "can_do": "link your ideas together",
 "dialogue": [
  {
   "sq": "Pse nuk erdhe dje?",
   "en": "Why didn't you come yesterday?"
  },
  {
   "sq": "Isha shumë i lodhur, prandaj ndenja në shtëpi.",
   "en": "I was very tired, so I stayed at home."
  },
  {
   "sq": "Megjithatë, mund të më telefonoje!",
   "en": "Still, you could have phoned me!"
  },
  {
   "sq": "Ke të drejtë, më fal. Nuk kisha as bateri në telefon.",
   "en": "You are right, sorry. I didn't even have battery in my phone."
  },
  {
   "sq": "Në rregull. Gjithsesi, herën tjetër më njofto.",
   "en": "All right. Anyway, next time let me know."
  }
 ]
