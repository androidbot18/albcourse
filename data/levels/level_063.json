 "opening": true,
 "unit": 20,
 "unit_title": "Clothes and colours",
 "situation": "Shopping",
 "can_do": "say what you want to wear and in which colour",
 "dialogue": [
  {
   "sq": "Mund ta provoj këtë këmishë?",
   "en": "Can I try on this shirt?"
  },
  {
   "sq": "Sigurisht. Çfarë mase keni?",
   "en": "Of course. What size are you?"
  },
  {
   "sq": "Nuk e di. Kjo është pak e ngushtë.",
   "en": "I don't know. This one is a little tight."
  },
  {
   "sq": "Ja një më e madhe.",
   "en": "Here is a bigger one."
  },
  {
   "sq": "Kjo më rri mirë. E keni në ngjyrë blu?",
   "en": "This fits me well. Do you have it in blue?"
  },
  {
   "sq": "Jo, vetëm të bardhë dhe të zezë.",
   "en": "No, only white and black."
  }
 ]
}