 "unit_title": "Going out to eat",
 "situation": "Café and restaurant",
 "can_do": "invite someone and agree a time",
 "dialogue": [
  {
   "sq": "Ana, dalim për darkë sonte?",
   "en": "Ana, shall we go out for dinner tonight?"
  },
  {
   "sq": "Ide e mirë! Ku shkojmë?",
   "en": "Good idea! Where shall we go?"
  },
  {
   "sq": "Njoh një restorant shumë të mirë.",
   "en": "I know a very good restaurant."
  },
  {
   "sq": "Në çfarë ore?",
   "en": "At what time?"
  },
  {
   "sq": "Në orën tetë. Është në rregull?",
   "en": "At eight o'clock. Is that all right?"
  },
  {
   "sq": "Po, takohemi në tetë.",
   "en": "Yes, we meet at eight."
  }
