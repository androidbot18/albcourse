 "dialogue": [
  {
   "sq": "Si të duket shqipja?",
   "en": "How do you find Albanian?"
  },
  {
   "sq": "Në fillim ishte e vështirë, por tani është më e lehtë.",
   "en": "At the beginning it was difficult, but now it is easier."
  },
  {
   "sq": "Flet shumë mirë! Ke bërë shumë përparim.",
   "en": "You speak very well! You have made a lot of progress."
  },
  {
   "sq": "Faleminderit! Gaboj shpesh, por përpiqem.",
   "en": "Thank you! I often make mistakes, but I try."
  },
  {
   "sq": "Kjo është normale. Është e rëndësishme të praktikosh çdo ditë.",
   "en": "That is normal. It is important to practise every day."
  }
 ]
